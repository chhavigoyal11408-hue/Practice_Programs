# 9. Write a Python program to check if a given number is prime or not.

num = int(input("Enter a number: "))

if num < 2:
    print("Not a prime number")
else:
    for i in range(2, num):
        if num % i == 0:
            print("Not a prime number")
            break
    else:
        print("Prime number")
# 10. Write a Python program to print prime numbers between 10 to 99.

for num in range(10, 100):
    if num < 2:
        continue

    for i in range(2, num):
        if num % i == 0:
            break
    else:
        print(num)
