
# Write a program to print the 4th element from first and 4th element from last in a tuple.

my_tuple = (10, 20, 30, 40, 50, 60, 70)

print("4th element from first:", my_tuple[3])
print("4th element from last:", my_tuple[-4])
4th element from first: 40
4th element from last: 40
# Write a program to check whether an element exists in a tuple or not.

my_tuple = (10, 20, 30, 40, 50)

element = int(input("Enter an element: "))

if element in my_tuple:
    print("Element exists in the tuple")
else:
    print("Element does not exist in the tuple")
Element exists in the tuple
# Write a program to convert a list into a tuple.

my_list = [10, 20, 30, 40, 50]

my_tuple = tuple(my_list)

print("List:", my_list)
print("Tuple:", my_tuple)
List: [10, 20, 30, 40, 50]
Tuple: (10, 20, 30, 40, 50)
# Write a program to find the index of an item in a tuple.

my_tuple = (10, 20, 30, 40, 50)

item = int(input("Enter an item: "))

print("Index of item:", my_tuple.index(item))
