# Write a program to replace last value of tuples in a list to 100.

my_list = [(10, 20, 40), (40, 50, 60), (70, 80, 90)]

for i in range(len(my_list)):
    my_list[i] = my_list[i][:-1] + (100,)

print(my_list)
[(10, 20, 100), (40, 50, 100), (70, 80, 100)]
